# ---- Database ----
POSTGRES_USER=bindery
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bindery
DATABASE_URL=postgresql+asyncpg://bindery:change-me@postgres:5432/bindery

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# ---- Storage (16 TB pool on the ZimaOS host) ----
DATA_ROOT=/data
INBOX_ROOT=/data/inbox

# ---- Pipeline ----
WORKER_CONCURRENCY=3          # OCR slots; sized for 16 GB / Ryzen
OCR_LANGUAGES=eng
OCR_DESKEW=true
OCR_CLEAN=true

# ---- AI (see ADR-003) ----
ANTHROPIC_API_KEY=
BINDERY_MODEL=claude-opus-5
BINDERY_PROMPT_VERSION=v1
BINDERY_USE_BATCH_FOR_BACKLOG=true

# ---- Ingress (see ADR-006) ----
CLOUDFLARE_TUNNEL_TOKEN=
BINDERY_HOSTNAME=bindery.d3cloud.io
