# ---- Database ----
POSTGRES_USER=bindery
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bindery
DATABASE_URL=postgresql+asyncpg://bindery:change-me@postgres:5432/bindery

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
# Set false only for plain-HTTP local work; production is always behind TLS.
COOKIE_SECURE=true

# ---- Storage ----
# HOST_DATA_ROOT is the path on the host that gets bind-mounted (the 16 TB pool
# on the ZimaOS box). DATA_ROOT is the path *inside* the containers and should
# not change. Keeping them separate is what lets the stack run on a laptop.
# Relative paths resolve from infra/, since that is where the compose file lives.
HOST_DATA_ROOT=../.data
DATA_ROOT=/data
INBOX_ROOT=/data/inbox

# ---- Pipeline ----
WORKER_CONCURRENCY=3          # OCR slots; sized for 16 GB / Ryzen
OCR_LANGUAGES=eng
OCR_DESKEW=true
OCR_CLEAN=true

# ---- AI (see ADR-003) ----
ANTHROPIC_API_KEY=
BINDERY_MODEL=claude-opus-5
BINDERY_PROMPT_VERSION=v1
BINDERY_USE_BATCH_FOR_BACKLOG=true

# ---- Ingress (see ADR-006) ----
# Token-mode tunnel: ingress rules are configured in the Cloudflare dashboard,
# so there is no cloudflared config file in the repo. The tunnel only starts
# under the `tunnel` profile.
CLOUDFLARE_TUNNEL_TOKEN=
BINDERY_HOSTNAME=bindery.d3cloud.io
