# ---------------------------------------------------------------------------
# base — dependencies only. Installed from pyproject.toml without installing the
# project, so this layer is cached until dependencies actually change.
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS base
WORKDIR /app
# pg_dump for backups (REQ-096) and psql for the restore drill.
#
# Pinned to 16 to match the server, from PGDG because Debian trixie only ships
# 17. A newer client dumps an older server fine — but it writes a newer *archive
# format*, and pg_restore 16 then refuses it with "unsupported version (1.16) in
# file header". That failure only appears when you try to restore, which is
# precisely the moment it must not appear. Found by running the drill.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg openssl \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-16 \
 && apt-get purge -y curl gnupg && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*
# The account the shipped image runs as. Created in `base` so both stages have
# it and only `runtime` switches to it — `dev` stays root, because the test
# container bind-mounts the working tree from whatever uid the developer's
# checkout happens to use.
#
# A fixed uid, not one the distro picks: it has to match the ownership of
# /media/Main-Storage/bindery/data on the host, and a uid that moves between
# base-image rebuilds is a uid that silently stops matching. 10001 is above
# Debian's system range and above ZimaOS's own accounts.
RUN groupadd --gid 10001 bindery \
 && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/bindery \
      --shell /usr/sbin/nologin bindery
# requirements.lock is copied alongside pyproject.toml for two reasons. It pins
# the whole transitive closure, so this image and the one CI tested are the same
# software — and it puts the lock's content hash into this layer's cache key, so
# a dependency change busts the pip layer and nothing else does. Without it the
# buildx cache pins the resolution invisibly and a security fix cannot reach a
# published image at all.
COPY pyproject.toml requirements.lock infra/extract-deps.py ./
RUN python extract-deps.py > /tmp/requirements.txt \
 && pip install --no-cache-dir -c requirements.lock -r /tmp/requirements.txt \
 && rm extract-deps.py

# ---------------------------------------------------------------------------
# runtime — the shipped api image
# ---------------------------------------------------------------------------
FROM base AS runtime
COPY api/ ./api/
COPY alembic/ ./alembic/
COPY alembic.ini ./
# Unprivileged from here on. Invariant 1 says originals are never modified, and
# in this deployment that is enforced by file mode: every blob is written 0444.
# A process running as uid 0 ignores the write bit entirely, so as root that
# invariant was a convention rather than a guarantee — and the whole 11 TB
# archive is bind-mounted read-write at /data, under a login page that has faced
# the open internet since Cloudflare Access was removed (invariant 9). Now a
# stray write, a traversal in an upload filename or a compromise of the api
# lands as a permission error against a 0444 file instead of overwriting the
# original.
#
# It listens on 8000, above 1024, so no capability is needed. Nothing is written
# under /app (Python simply skips the __pycache__ it cannot create); everything
# the process writes is /data or /tmp.
#
# **The host has to agree.** /data must be owned by 10001, or the api comes up
# healthy and fails on the first write. See docs/zimaos-deploy.md, step 3.
USER bindery
# `python -m` puts /app first on sys.path. Do not switch to the bare `uvicorn`
# console script: it would resolve `api` from site-packages instead.
# `--proxy-headers` with `--forwarded-allow-ips`: uvicorn trusts 127.0.0.1 by default, and
# nginx is a different container with an address Docker reassigns on every recreate, so the
# X-Forwarded-Proto it sets was being ignored and every absolute URL the api built came out
# `http://`. Trusting the whole network is safe here because nothing else can reach this
# port: the compose network is private and REQ-104 forbids publishing one.
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]

# Stamped at the end of the *runtime* stage, on purpose. These change on every
# commit, so an ARG consumed earlier would invalidate every layer built after
# it — and the shipped stage is `runtime`, so stamping the file's last stage
# would have put `unknown` in every image CI publishes (REQ-152).
ARG BINDERY_COMMIT=unknown
ARG BINDERY_BUILT_AT=unknown
ARG BINDERY_REF=unknown
ENV BINDERY_COMMIT=$BINDERY_COMMIT \
    BINDERY_BUILT_AT=$BINDERY_BUILT_AT \
    BINDERY_REF=$BINDERY_REF

# ---------------------------------------------------------------------------
# dev — same deps plus the test toolchain and the full tree. Used by the `test`
# compose service; never deployed.
# ---------------------------------------------------------------------------


FROM base AS dev
# git is here for one test: `test_docs.py` asks when a screen's source last
# changed, to catch a documentation screenshot that is quietly out of date.
# Skipping the check when git is missing would make it a check that silently
# does not run, which is the thing it exists to prevent.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml requirements.lock infra/extract-deps.py ./
RUN python extract-deps.py dev > /tmp/dev-requirements.txt \
 && pip install --no-cache-dir -c requirements.lock -r /tmp/dev-requirements.txt \
 && rm extract-deps.py
COPY . .
CMD ["python", "-m", "pytest"]

