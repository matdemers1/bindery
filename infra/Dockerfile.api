# ---------------------------------------------------------------------------
# base — dependencies only. Installed from pyproject.toml without installing the
# project, so this layer is cached until dependencies actually change.
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS base
WORKDIR /app
# pg_dump for backups (REQ-096) and psql for the restore drill. A newer client
# can dump an older server, so the distro's version is fine against Postgres 16.
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client openssl \
 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml infra/extract-deps.py ./
RUN python extract-deps.py > /tmp/requirements.txt \
 && pip install --no-cache-dir -r /tmp/requirements.txt \
 && rm extract-deps.py

# ---------------------------------------------------------------------------
# runtime — the shipped api image
# ---------------------------------------------------------------------------
FROM base AS runtime
COPY api/ ./api/
COPY alembic/ ./alembic/
COPY alembic.ini ./
# `python -m` puts /app first on sys.path. Do not switch to the bare `uvicorn`
# console script: it would resolve `api` from site-packages instead.
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ---------------------------------------------------------------------------
# dev — same deps plus the test toolchain and the full tree. Used by the `test`
# compose service; never deployed.
# ---------------------------------------------------------------------------
FROM base AS dev
COPY pyproject.toml infra/extract-deps.py ./
RUN python extract-deps.py dev > /tmp/dev-requirements.txt \
 && pip install --no-cache-dir -r /tmp/dev-requirements.txt \
 && rm extract-deps.py
COPY . .
CMD ["python", "-m", "pytest"]
