# ---------------------------------------------------------------------------
# base — dependencies only. Installed from pyproject.toml without installing the
# project, so this layer is cached until dependencies actually change.
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS base
WORKDIR /app
# pg_dump for backups (REQ-096) and psql for the restore drill.
#
# Pinned to 16 to match the server, from PGDG because Debian trixie only ships
# 17. A newer client dumps an older server fine — but it writes a newer *archive
# format*, and pg_restore 16 then refuses it with "unsupported version (1.16) in
# file header". That failure only appears when you try to restore, which is
# precisely the moment it must not appear. Found by running the drill.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg openssl \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-16 \
 && apt-get purge -y curl gnupg && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml infra/extract-deps.py ./
RUN python extract-deps.py > /tmp/requirements.txt \
 && pip install --no-cache-dir -r /tmp/requirements.txt \
 && rm extract-deps.py

# ---------------------------------------------------------------------------
# runtime — the shipped api image
# ---------------------------------------------------------------------------
FROM base AS runtime
COPY api/ ./api/
COPY alembic/ ./alembic/
COPY alembic.ini ./
# `python -m` puts /app first on sys.path. Do not switch to the bare `uvicorn`
# console script: it would resolve `api` from site-packages instead.
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Stamped at the end of the *runtime* stage, on purpose. These change on every
# commit, so an ARG consumed earlier would invalidate every layer built after
# it — and the shipped stage is `runtime`, so stamping the file's last stage
# would have put `unknown` in every image CI publishes (REQ-152).
ARG BINDERY_COMMIT=unknown
ARG BINDERY_BUILT_AT=unknown
ARG BINDERY_REF=unknown
ENV BINDERY_COMMIT=$BINDERY_COMMIT \
    BINDERY_BUILT_AT=$BINDERY_BUILT_AT \
    BINDERY_REF=$BINDERY_REF

# ---------------------------------------------------------------------------
# dev — same deps plus the test toolchain and the full tree. Used by the `test`
# compose service; never deployed.
# ---------------------------------------------------------------------------


FROM base AS dev
# git is here for one test: `test_docs.py` asks when a screen's source last
# changed, to catch a documentation screenshot that is quietly out of date.
# Skipping the check when git is missing would make it a check that silently
# does not run, which is the thing it exists to prevent.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml infra/extract-deps.py ./
RUN python extract-deps.py dev > /tmp/dev-requirements.txt \
 && pip install --no-cache-dir -r /tmp/dev-requirements.txt \
 && rm extract-deps.py
COPY . .
CMD ["python", "-m", "pytest"]

