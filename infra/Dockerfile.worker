FROM python:3.13-slim AS base

# OCR toolchain — see Architecture.md L5. OCRmyPDF shells out to all of these.
RUN apt-get update && apt-get install -y --no-install-recommends \
      tesseract-ocr tesseract-ocr-eng \
      ghostscript \
      poppler-utils \
      qpdf \
      unpaper \
      pngquant \
    && rm -rf /var/lib/apt/lists/*

# Office formats. A household archive is full of documents that never touched a
# scanner — a spreadsheet of account numbers, a letter written in Word, a CSV
# export from a bank — and they carry exactly the information the archive exists
# to find. They are converted to PDF and then travel the ordinary path, so they
# end up searchable, citable and exportable like everything else.
#
# Only the filters actually needed: `libreoffice` pulls in a desktop, Java and
# a lot of things a headless converter never runs. This is roughly 400MB rather
# than well over a gigabyte.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libreoffice-writer-nogui \
      libreoffice-calc-nogui \
      libreoffice-impress-nogui \
      fonts-dejavu-core \
      fonts-liberation2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml infra/extract-deps.py ./
RUN python extract-deps.py worker > /tmp/requirements.txt \
 && pip install --no-cache-dir -r /tmp/requirements.txt \
 && rm extract-deps.py

FROM base AS runtime
COPY api/ ./api/
COPY worker/ ./worker/
CMD ["python", "-m", "worker.runner"]

# Stamped at the end of the *runtime* stage, on purpose. These change on every
# commit, so an ARG consumed earlier would invalidate every layer built after
# it — and the shipped stage is `runtime`, so stamping the file's last stage
# would have put `unknown` in every image CI publishes (REQ-152).
ARG BINDERY_COMMIT=unknown
ARG BINDERY_BUILT_AT=unknown
ARG BINDERY_REF=unknown
ENV BINDERY_COMMIT=$BINDERY_COMMIT \
    BINDERY_BUILT_AT=$BINDERY_BUILT_AT \
    BINDERY_REF=$BINDERY_REF

# ---------------------------------------------------------------------------
# dev — the OCR toolchain plus the test harness. Used by the `test-worker`
# compose service for the pipeline and golden-corpus suites, which need real
# Tesseract and cannot run in the api test image. Never deployed.
# ---------------------------------------------------------------------------


FROM base AS dev
COPY pyproject.toml infra/extract-deps.py ./
RUN python extract-deps.py dev > /tmp/dev-requirements.txt \
 && pip install --no-cache-dir -r /tmp/dev-requirements.txt \
 && rm extract-deps.py
COPY . .
CMD ["python", "-m", "pytest", "-m", "slow"]

