{
  "Rules": [
    {
      "ID": "expire-daily-dumps",
      "Status": "Enabled",
      "Filter": { "Prefix": "dumps/daily/" },
      "Expiration": { "Days": 7 },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 1 }
    },
    {
      "ID": "expire-weekly-dumps",
      "Status": "Enabled",
      "Filter": { "Prefix": "dumps/weekly/" },
      "Expiration": { "Days": 35 },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 1 }
    },
    {
      "ID": "tidy-expired-delete-markers",
      "Status": "Enabled",
      "Filter": { "Prefix": "dumps/" },
      "Expiration": { "ExpiredObjectDeleteMarker": true }
    },
    {
      "ID": "abort-incomplete-multipart",
      "Status": "Enabled",
      "Filter": { "Prefix": "" },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 7 }
    }
  ]
}
